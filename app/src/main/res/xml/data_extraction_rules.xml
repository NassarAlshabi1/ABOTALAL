<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules (Android 12+ / API 31+).
  Same policy as the legacy backup rules: router credentials (Room database)
  and Telegram bot tokens (shared preferences) are excluded from cloud backups
  and device-to-device transfers.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="card_backgrounds" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="card_backgrounds" />
    </device-transfer>
</data-extraction-rules>
