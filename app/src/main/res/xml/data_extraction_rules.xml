<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules (Android 12+): same policy as backup_rules.xml —
  credential-bearing data (Room DB with router passwords, Telegram bot tokens,
  card templates) is excluded from cloud backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="abo_talal_db" />
        <exclude domain="database" path="netcraft_db" />
        <exclude domain="sharedpref" path="netcraft_telegram_prefs.xml" />
        <exclude domain="sharedpref" path="card_templates_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="abo_talal_db" />
        <exclude domain="database" path="netcraft_db" />
        <exclude domain="sharedpref" path="netcraft_telegram_prefs.xml" />
        <exclude domain="sharedpref" path="card_templates_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
