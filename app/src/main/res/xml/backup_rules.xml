<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules (Android < 12): the Room database and credential-bearing
  preferences must NEVER leave the device via auto-backup — they hold router
  passwords (now encrypted at rest, but still) and Telegram bot tokens.
-->
<full-backup-content>
    <exclude domain="database" path="abo_talal_db" />
    <exclude domain="database" path="netcraft_db" />
    <exclude domain="sharedpref" path="netcraft_telegram_prefs.xml" />
    <exclude domain="sharedpref" path="card_templates_prefs.xml" />
</full-backup-content>
