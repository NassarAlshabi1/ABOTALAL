<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-backup content rules (devices older than API 31).
  The app database stores router credentials and the shared preferences store
  Telegram bot tokens — both are excluded from adb/cloud backups so secrets
  never leave the device unencrypted.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="card_backgrounds" />
</full-backup-content>
